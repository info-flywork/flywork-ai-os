PORT=4000
NODE_ENV=production
HOST=0.0.0.0
APP_URL=https://apppanel.fly-work.com
# Virgulle ayrilmis host listesi; sadece sertifika sorunu olan gecici istisnalar icin.
PANEL_INSECURE_TLS_HOSTS=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=app_panel

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@app-panel.local
SUPER_ADMIN_PASSWORD=Admin123!

# E-posta dogrulamasi (false = sadece email/sifre ile giris, test icin)
LOGIN_EMAIL_VERIFICATION=true

# SMTP — giris e-posta dogrulamasi (zorunlu: production, dogrulama acikken)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=panel@example.com
SMTP_PASS=
SMTP_FROM=panel@example.com
SMTP_FROM_NAME=Flywork Ventures Panel

