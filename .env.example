# Bu dosyada gerçek şifre veya oturum anahtarı tutmayın.
# Çalışan değerleri yalnızca .env içine yazın. .env depoya eklenmez.

# MariaDB veya MySQL bağlantısı.
# mysql://KULLANICI:SIFRE@127.0.0.1:3306/VERITABANI
DATABASE_URL="mysql://KULLANICI:SIFRE@127.0.0.1:3306/flywork_ai_os"

# Üretimde NODE_ENV=production olmadan süreç açmayın.
# Uygulama yalnızca 127.0.0.1 üzerinde dinler. Dışarıyı HTTPS vekil sunucusu açar.
# PORT=3010

# En az 32 karakterlik rastgele anahtar. Üretimde boş veya kısa değer süreci durdurur.
# Üretmek için: openssl rand -base64 32
SESSION_SECRET=""

# İlk yöneticiyi yalnızca bir kez, kabuk ortamında verin. Bu değerleri dosyaya yazmayın.
# ADMIN_NAME="Ad Soyad" ADMIN_EMAIL="eposta@sirket.com" ADMIN_PASSWORD="..." npm run admin:create

# Google OAuth. Üç değer de dolu olmadan hesap bağlanmaz ve posta okunmaz.
# Yenileme anahtarı .env dosyasına yazılmaz; bağlantı sonrası veritabanında şifreli durur.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Yerel: http://127.0.0.1:3010/api/google/oauth/callback
# Üretim: https://PANEL-ALANINIZ/api/google/oauth/callback
# GOOGLE_REDIRECT_URI=""

# OpenAI Responses API ile görsel fatura analizi. Anahtar boşsa okuyucu "Bağlantı bekleniyor" der.
# Gerçek anahtarı yalnızca .env dosyasına yazın.
AI_DOCUMENT_PROVIDER="openai"
AI_DOCUMENT_API_KEY=""
AI_DOCUMENT_MODEL="gpt-4o"

# Telegram gönderimi kapalıdır. Tokenı yalnızca .env dosyasına yazın.
# BotFather'dan alınan token buraya gelir. Sohbet kimliği yazılmaz; yönetici panelden eşleşir.
# TELEGRAM_BOT_TOKEN=""
# Webhook gizli başlığı. Boşsa gelen Telegram çağrıları reddedilir.
# TELEGRAM_WEBHOOK_SECRET=""
# Canlı gönderim için değer yalnızca live olabilir. Başka her değer gönderimi kapalı tutar.
# TELEGRAM_DELIVERY="off"
# Webhook adresi. npm run telegram:webhook yalnızca bakar. Kayıt için --apply gerekir.
# TELEGRAM_WEBHOOK_URL="https://PANEL-ALANINIZ/api/telegram/webhook"
# SMTP_HOST=""
# SMTP_FROM=""
